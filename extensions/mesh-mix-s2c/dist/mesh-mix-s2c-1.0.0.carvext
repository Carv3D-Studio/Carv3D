{"format":"carv3d-extension","formatVersion":1,"manifest":{"id":"mesh-mix-s2c","name":{"en":"Mesh Mix-S2C converter","de":"Mesh Mix-S2C Umwandler"},"version":"1.0.0","apiVersion":1,"author":"Carv3D Studio community","license":"AGPL-3.0-only","description":{"en":"Turns a mesh body (for example an imported STL) into a body with exact, editable faces using the separately installed program Mesh Mix-S2C. The original body is kept.","de":"Wandelt einen Netzkörper (zum Beispiel einen importierten STL) mit dem getrennt installierten Programm Mesh Mix-S2C in einen Körper mit exakten, bearbeitbaren Flächen um. Der ursprüngliche Körper bleibt erhalten."},"homepage":"https://github.com/Carv3D-Studio/Carv3D/tree/main/extensions/mesh-mix-s2c","permissions":["read-document","import-files","run-program"],"programs":[{"id":"mesh-mix-s2c","name":"Mesh Mix-S2C","homepage":"https://github.com/STL2CURVES-MMM/Mesh-Mix-S2C","license":"AGPL-3.0-only"}],"commands":[{"name":"convert","title":{"en":"Convert mesh body to exact faces (Mesh Mix)","de":"Netzkörper in exakte Flächen umwandeln (Mesh Mix)"},"description":{"en":"Exports the selected body (or the only body) as STL, converts it to STEP with Mesh Mix-S2C on this computer and adds the result as a new body next to the original. Nothing is uploaded. Detailed meshes can take several minutes.","de":"Gibt den gewählten (oder einzigen) Körper als STL aus, wandelt ihn mit Mesh Mix-S2C auf diesem Rechner in STEP um und legt das Ergebnis als neuen Körper neben das Original. Es wird nichts hochgeladen. Feine Netze können einige Minuten dauern."},"menu":"maker","params":[{"id":"body","type":"body","optional":true,"label":{"en":"Body","de":"Körper"}},{"id":"preset","type":"choice","label":{"en":"Method","de":"Verfahren"},"default":"auto","choices":[{"value":"auto","label":{"en":"Automatic","de":"Automatisch"}},{"value":"cad","label":{"en":"Clean CAD export","de":"Sauberer CAD-Export"}},{"value":"smooth","label":{"en":"Smooth, organic shapes","de":"Glatte, organische Formen"}},{"value":"precise","label":{"en":"Precise","de":"Genau"}},{"value":"exact","label":{"en":"Exact","de":"Exakt"}}]},{"id":"repair","type":"choice","label":{"en":"Mesh repair","de":"Netz reparieren"},"default":"auto","choices":[{"value":"off","label":{"en":"Off","de":"Aus"}},{"value":"auto","label":{"en":"Automatic","de":"Automatisch"}},{"value":"aggressive","label":{"en":"Aggressive","de":"Gründlich"}}]},{"id":"quality","type":"number","label":{"en":"Quality (0 = fast, 1 = best)","de":"Qualität (0 = schnell, 1 = beste)"},"default":0.7,"min":0,"max":1,"step":0.05}]}]},"code":"// sdk/src/index.ts\nfunction defineExtension(module) {\n  return module;\n}\n\n// ../Carv3D-Public/extensions/mesh-mix-s2c/src/index.ts\nvar PROGRAM = \"mesh-mix-s2c\";\nvar INPUT_FILE = \"in.stl\";\nvar OUTPUT_FILE = \"out.step\";\nvar TIMEOUT_SECONDS = 15 * 60;\nvar NAME_SUFFIX = \" (STEP)\";\nvar OUTPUT_TAIL = 400;\nvar TEXTS = {\n  en: {\n    done: (count) => `Converted: ${count} body with exact faces. The original is kept.`,\n    noBody: \"There is no body to convert.\",\n    pickBody: \"Select the body to convert first.\",\n    notInstalled: 'Mesh Mix-S2C was not found. Install it separately (a folder named \"Mesh-Mix-S2C\" next to the Carv3D folder, or set CARV3D_MESHMIX_DIR) together with its Python environment; see the extension README.',\n    pythonMissing: \"Mesh Mix-S2C was found but its Python environment is missing. Create the .venv in its folder or set CARV3D_MESHMIX_PYTHON; see the extension README.\",\n    unavailable: \"The conversion needs the local Carv3D server (npm run dev or START.bat), not a static page.\",\n    timeout: \"The conversion took too long and was stopped. Use a coarser mesh or a lower quality.\",\n    busy: \"A conversion is already running. Wait until it has finished.\",\n    failed: (tail) => `Mesh Mix-S2C could not convert the mesh. A dense, closed mesh helps.${tail ? ` Program output: ${tail}` : \"\"}`\n  },\n  de: {\n    done: (count) => `Umgewandelt: ${count} K\\xF6rper mit exakten Fl\\xE4chen. Das Original bleibt erhalten.`,\n    noBody: \"Es gibt keinen K\\xF6rper zum Umwandeln.\",\n    pickBody: \"W\\xE4hle zuerst den K\\xF6rper, der umgewandelt werden soll.\",\n    notInstalled: \"Mesh Mix-S2C wurde nicht gefunden. Installiere es getrennt (Ordner \\u201EMesh-Mix-S2C\\u201C neben dem Carv3D-Ordner oder CARV3D_MESHMIX_DIR setzen) samt Python-Umgebung; siehe README der Erweiterung.\",\n    pythonMissing: \"Mesh Mix-S2C wurde gefunden, aber seine Python-Umgebung fehlt. Lege das .venv in seinem Ordner an oder setze CARV3D_MESHMIX_PYTHON; siehe README der Erweiterung.\",\n    unavailable: \"Die Umwandlung braucht den lokalen Carv3D-Server (npm run dev oder START.bat), nicht eine statische Seite.\",\n    timeout: \"Die Umwandlung dauerte zu lange und wurde abgebrochen. Nimm ein gr\\xF6beres Netz oder eine niedrigere Qualit\\xE4t.\",\n    busy: \"Es l\\xE4uft schon eine Umwandlung. Warte, bis sie fertig ist.\",\n    failed: (tail) => `Mesh Mix-S2C konnte das Netz nicht umwandeln. Ein dichtes, geschlossenes Netz hilft.${tail ? ` Ausgabe des Programms: ${tail}` : \"\"}`\n  }\n};\nfunction textsFor(language) {\n  return language in TEXTS ? TEXTS[language] : TEXTS.en;\n}\nfunction explain(error, language) {\n  const text = textsFor(language);\n  const message = error instanceof Error ? error.message : String(error);\n  if (message.startsWith(\"program_not_installed\")) return new Error(message.includes(\"python_missing\") ? text.pythonMissing : text.notInstalled);\n  if (message.startsWith(\"program_unavailable\")) return new Error(text.unavailable);\n  if (message.startsWith(\"program_timeout\")) return new Error(text.timeout);\n  if (message.startsWith(\"program_busy\")) return new Error(text.busy);\n  return error instanceof Error ? error : new Error(message);\n}\nasync function chooseBody(ctx, requested) {\n  const text = textsFor(ctx.language);\n  const bodies = (await ctx.document()).bodies ?? [];\n  if (bodies.length === 0) throw new Error(text.noBody);\n  const body = requested ? bodies.find((entry) => entry.id === requested) : bodies.length === 1 ? bodies[0] : void 0;\n  if (!body) throw new Error(text.pickBody);\n  return { id: body.id, name: body.name ?? body.id };\n}\nvar index_default = defineExtension({\n  commands: {\n    /** Körper → STL → Mesh Mix-S2C → STEP → neuer Körper. */\n    async convert(ctx, args) {\n      const input = args;\n      const text = textsFor(ctx.language);\n      const body = await chooseBody(ctx, input.body);\n      const stl = await ctx.exportModel(\"stl\", [body.id]);\n      let outcome;\n      try {\n        outcome = await ctx.runProgram({\n          program: PROGRAM,\n          args: [\n            \"convert\",\n            `{work}/${INPUT_FILE}`,\n            \"-o\",\n            `{work}/${OUTPUT_FILE}`,\n            \"--preset\",\n            input.preset,\n            \"--repair\",\n            input.repair,\n            \"--quality\",\n            String(input.quality),\n            \"--json\"\n          ],\n          inputs: { [INPUT_FILE]: stl },\n          outputs: [OUTPUT_FILE],\n          timeoutSeconds: TIMEOUT_SECONDS\n        });\n      } catch (error) {\n        throw explain(error, ctx.language);\n      }\n      const step = outcome.files[OUTPUT_FILE];\n      if (outcome.code !== 0 || !step) throw new Error(text.failed(outcome.output.trim().slice(-OUTPUT_TAIL)));\n      const { count } = await ctx.importFile(\"mesh-mix.step\", step, `${body.name}${NAME_SUFFIX}`);\n      return { ok: true, message: { en: TEXTS.en.done(count), de: TEXTS.de.done(count) }, source: body.id, bodies: count };\n    }\n  }\n});\nexport {\n  index_default as default\n};\n"}
